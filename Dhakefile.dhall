CE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/entropy_poll.o vendor/mbedtls/library/entropy_poll.c; fi; if [ ! -f vendor/mbedtls/build/error.o ] || [ vendor/mbedtls/library/error.c -nt vendor/mbedtls/build/error.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/error.o vendor/mbedtls/library/error.c; fi; if [ ! -f vendor/mbedtls/build/gcm.o ] || [ vendor/mbedtls/library/gcm.c -nt vendor/mbedtls/build/gcm.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/gcm.o vendor/mbedtls/library/gcm.c; fi; if [ ! -f vendor/mbedtls/build/md.o ] || [ vendor/mbedtls/library/md.c -nt vendor/mbedtls/build/md.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/md.o vendor/mbedtls/library/md.c; fi; if [ ! -f vendor/mbedtls/build/oid.o ] || [ vendor/mbedtls/library/oid.c -nt vendor/mbedtls/build/oid.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/oid.o vendor/mbedtls/library/oid.c;