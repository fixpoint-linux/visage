-- Dhakefile.dhall — build the entire visage repo with dhake (no Make).
--
-- One buildfile drives every build target (C binaries + mbedTLS + Elm
-- docs site), with hash-verified builds:
--   * `hash`     — expected sha256 of each non-phony output (verified after build)
--   * `depsHash` — expected sha256 of every input source (verified before build)
--
-- Usage:
--   ./vendor/dhake/dhake.com                    # build all (default target: `all`)
--   ./vendor/dhake/dhake.com visage.com         # one binary
--   ./vendor/dhake/dhake.com dist/index.html    # the Elm docs site
--   ./vendor/dhake/dhake.com e2e                # host integration tests
--   ./vendor/dhake/dhake.com bench              # store benchmark + plots
--   ./vendor/dhake/dhake.com --verify           # CI pre-flight: pin checks + up-to-date
--   ./vendor/dhake/dhake.com --warn-hash-mismatch TARGET  # re-pin stale hashes
--
-- Generated by tools/gen_dhakefile.py; do not hand-edit the hash pins.

let Action =
      < Shell : Text
      | Copy : { from : Text, to : Text }
      | Mkdir : < Plain : Text | Parents : { path : Text, parents : Bool } >
      | Rm : < Plain : Text | Recursive : { path : Text, recursive : Bool } >
      | Touch : Text
      | Move : { from : Text, to : Text }
      | Symlink : { from : Text, to : Text }
      | Chmod : { path : Text, mode : Text }
      | Echo : Text
      | Env : { key : Text, value : Text }
      | Run : { argv : List Text }
      >

let Target = { deps : List Text, phony : Bool, recipe : List Action
             , hash : Optional Text
             , depsHash : Optional (List { path : Text, hash : Text })
             , arch : Optional Text
             }

in  { targets = [
        { mapKey = "vendor/mbedtls/build/.stamp"
        , mapValue =
            { deps = [ "src/mbedtls_visage_config.h", "vendor/mbedtls/library/aes.c", "vendor/mbedtls/library/asn1parse.c", "vendor/mbedtls/library/asn1write.c", "vendor/mbedtls/library/base64.c", "vendor/mbedtls/library/bignum.c", "vendor/mbedtls/library/bignum_core.c", "vendor/mbedtls/library/bignum_mod.c", "vendor/mbedtls/library/bignum_mod_raw.c", "vendor/mbedtls/library/cipher.c", "vendor/mbedtls/library/cipher_wrap.c", "vendor/mbedtls/library/constant_time.c", "vendor/mbedtls/library/ctr_drbg.c", "vendor/mbedtls/library/ecdh.c", "vendor/mbedtls/library/ecdsa.c", "vendor/mbedtls/library/ecp.c", "vendor/mbedtls/library/ecp_curves.c", "vendor/mbedtls/library/entropy.c", "vendor/mbedtls/library/entropy_poll.c", "vendor/mbedtls/library/error.c", "vendor/mbedtls/library/gcm.c", "vendor/mbedtls/library/md.c", "vendor/mbedtls/library/oid.c", "vendor/mbedtls/library/pem.c", "vendor/mbedtls/library/pk.c", "vendor/mbedtls/library/pk_ecc.c", "vendor/mbedtls/library/pk_wrap.c", "vendor/mbedtls/library/pkparse.c", "vendor/mbedtls/library/platform.c", "vendor/mbedtls/library/platform_util.c", "vendor/mbedtls/library/rsa.c", "vendor/mbedtls/library/rsa_alt_helpers.c", "vendor/mbedtls/library/sha1.c", "vendor/mbedtls/library/sha256.c", "vendor/mbedtls/library/sha512.c", "vendor/mbedtls/library/ssl_cache.c", "vendor/mbedtls/library/ssl_ciphersuites.c", "vendor/mbedtls/library/ssl_client.c", "vendor/mbedtls/library/ssl_msg.c", "vendor/mbedtls/library/ssl_tls.c", "vendor/mbedtls/library/ssl_tls12_client.c", "vendor/mbedtls/library/ssl_tls12_server.c", "vendor/mbedtls/library/version.c", "vendor/mbedtls/library/x509.c", "vendor/mbedtls/library/x509_crt.c" ]
            , phony = False
            , recipe = [ < Shell = "set -e; mkdir -p vendor/mbedtls/build; if [ ! -f vendor/mbedtls/build/aes.o ] || [ vendor/mbedtls/library/aes.c -nt vendor/mbedtls/build/aes.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/aes.o vendor/mbedtls/library/aes.c; fi; if [ ! -f vendor/mbedtls/build/asn1parse.o ] || [ vendor/mbedtls/library/asn1parse.c -nt vendor/mbedtls/build/asn1parse.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/asn1parse.o vendor/mbedtls/library/asn1parse.c; fi; if [ ! -f vendor/mbedtls/build/asn1write.o ] || [ vendor/mbedtls/library/asn1write.c -nt vendor/mbedtls/build/asn1write.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/asn1write.o vendor/mbedtls/library/asn1write.c; fi; if [ ! -f vendor/mbedtls/build/base64.o ] || [ vendor/mbedtls/library/base64.c -nt vendor/mbedtls/build/base64.o ]; then cc -std=c11 -O2 -g -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE -I vendor/dhall-c/src -I vendor/datalog-dafsa/src -I vendor/datalog-dafsa/vendor -I vendor/mbedtls/include -I src -DMBEDTLS_CONFIG_FILE='\"mbedtls_visage_config.h\"' -c -o vendor/mbedtls/build/base64.o vendor/mbedtls/library/base64.c; fi; if [ ! -f vendor/mbedtls/build/bignum.o ] || [ vendor/mbedtls/library/bignum.c -nt vendor/mbedtls/build/bignum.o ]; then cc -std=c