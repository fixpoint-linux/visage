# /etc/jmapd/outbox.env — the submission credential jmapd hands to the outbox.
#
# Install as 0600 root-owned:
#   install -d -m 0755 /etc/jmapd
#   install -m 0600 deploy/jmapd-outbox.env.example /etc/jmapd/outbox.env
# then edit /etc/jmapd/outbox.env.  systemd reads it as root (before dropping
# to User=imapd) and passes it as the process environment, which is why the
# password is here and not in jmapd.service.
#
# One account per credential: this is the outbox's submission user, and it is
# the SAME credential the daemon authenticates its SMTP AUTH PLAIN with.  It is
# not a JMAP password (those live in <root>/imapd.passwd).
#
# Envelope sender is not set here: it comes from --identity in the unit (or
# <user>@<hostname>), so Identity/get and the submission envelope can never
# disagree.

JMAPD_OUTBOX_USER=visage
JMAPD_OUTBOX_PASS=change-me

# implicit (default) = SMTPS on :465, the outbox's implicit-TLS listener.
# starttls / starttls-verify also work.  none is refused unless the relay host
# is loopback, because the credential would cross the network in clear text.
JMAPD_OUTBOX_TLS=implicit

# Optional tuning, defaults shown.  --submit-wait is how long EmailSubmission/set
# waits for the relay's verdict before answering created ("accepted is not
# delivered", RFC 8621 7.5); inside that window the answer is authoritative.
# JMAPD_SUBMIT_WAIT=5000
# JMAPD_MAX_REQ=4194304
# JMAPD_TMO=300
